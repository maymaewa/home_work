FROM golang:1.25 AS build

WORKDIR /go/src/calendar

COPY go.mod go.sum ./
RUN go mod download

COPY . .

ARG LDFLAGS

RUN CGO_ENABLED=0 go build \
    -ldflags "$LDFLAGS" \
    -o /opt/calendar/calendar_sender \
    ./cmd/calendar_sender

FROM alpine:3.20

WORKDIR /opt/calendar

COPY --from=build /opt/calendar/calendar_sender /opt/calendar/calendar_sender
COPY ./configs/config.docker.toml /etc/calendar/config.toml

CMD ["/opt/calendar/calendar_sender", "-config", "/etc/calendar/config.toml"]