FROM golang:1.25 AS build

WORKDIR /go/src/calendar

COPY go.mod go.sum ./
RUN go mod download

COPY . .

ARG LDFLAGS

RUN CGO_ENABLED=0 go build \
    -ldflags "$LDFLAGS" \
    -o /opt/calendar/calendar_scheduler \
    ./cmd/calendar_scheduler

FROM alpine:3.20

WORKDIR /opt/calendar

COPY --from=build /opt/calendar/calendar_scheduler /opt/calendar/calendar_scheduler
COPY ./configs/config.integration.toml /etc/calendar/config.toml

CMD ["/opt/calendar/calendar_scheduler", "-config", "/etc/calendar/config.toml"]